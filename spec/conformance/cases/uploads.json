{
  "spec": "0.1.0-draft",
  "cases": [
    {
      "name": "upload-lifecycle-out-of-order",
      "description": "Initiate, send three parts in the order 3, 1, 2 (the last one short), query, complete, read the object back, and confirm the session is gone. The expected checksum is the CRC32C of the concatenated bytes, and it equals the combine vector in crc32c.json.",
      "decision": "ADR-0001",
      "fixtures": [
        "alice",
        "empty"
      ],
      "steps": [
        {
          "name": "initiate",
          "request": {
            "method": "POST",
            "path": [
              "-",
              "uploads"
            ],
            "auth": {
              "key": "alice"
            },
            "body": {
              "json": {
                "bucket": "empty",
                "key": "big.bin",
                "part_size": 5242880,
                "content_type": "application/octet-stream",
                "metadata": {
                  "title": "big"
                }
              }
            }
          },
          "expect": {
            "status": 201,
            "json": {
              "bucket": "empty",
              "key": "big.bin",
              "part_size": 5242880,
              "content_type": "application/octet-stream"
            },
            "json_present": [
              "/id",
              "/created_at",
              "/expires_at"
            ]
          },
          "capture": {
            "id": "/id"
          }
        },
        {
          "name": "part-3-short",
          "request": {
            "method": "PUT",
            "path": [
              "-",
              "uploads",
              "{{id}}",
              "parts",
              "3"
            ],
            "auth": {
              "key": "alice"
            },
            "body": {
              "bytes": {
                "seed": 10,
                "length": 1024
              }
            }
          },
          "expect": {
            "status": 200,
            "json": {
              "part": 3,
              "size": 1024,
              "checksum": "crc32c=16Iysw=="
            },
            "headers": {
              "X-Tunna-Checksum": "crc32c=16Iysw=="
            }
          }
        },
        {
          "name": "part-1",
          "request": {
            "method": "PUT",
            "path": [
              "-",
              "uploads",
              "{{id}}",
              "parts",
              "1"
            ],
            "auth": {
              "key": "alice"
            },
            "body": {
              "bytes": {
                "seed": 8,
                "length": 5242880
              }
            }
          },
          "expect": {
            "status": 200,
            "json": {
              "part": 1,
              "size": 5242880,
              "checksum": "crc32c=UXMjHQ=="
            }
          }
        },
        {
          "name": "part-2",
          "request": {
            "method": "PUT",
            "path": [
              "-",
              "uploads",
              "{{id}}",
              "parts",
              "2"
            ],
            "auth": {
              "key": "alice"
            },
            "body": {
              "bytes": {
                "seed": 9,
                "length": 5242880
              }
            }
          },
          "expect": {
            "status": 200,
            "json": {
              "part": 2,
              "size": 5242880,
              "checksum": "crc32c=ZagDLA=="
            }
          }
        },
        {
          "name": "query",
          "request": {
            "method": "GET",
            "path": [
              "-",
              "uploads",
              "{{id}}"
            ],
            "auth": {
              "key": "alice"
            }
          },
          "expect": {
            "status": 200,
            "json": {
              "part_size": 5242880,
              "parts": [
                1,
                2,
                3
              ]
            }
          }
        },
        {
          "name": "complete",
          "request": {
            "method": "POST",
            "path": [
              "-",
              "uploads",
              "{{id}}",
              "complete"
            ],
            "auth": {
              "key": "alice"
            },
            "body": {
              "json": {
                "parts": 3
              }
            }
          },
          "expect": {
            "status": 201,
            "headers": {
              "ETag": "\"crc32c=JKAp5Q==\"",
              "X-Tunna-Checksum": "crc32c=JKAp5Q=="
            },
            "json": {
              "bucket": "empty",
              "key": "big.bin",
              "size": 10486784,
              "checksum": "crc32c=JKAp5Q==",
              "content_type": "application/octet-stream",
              "metadata": {
                "title": "big"
              }
            }
          }
        },
        {
          "name": "get-object",
          "request": {
            "method": "GET",
            "path": [
              "empty",
              "big.bin"
            ],
            "auth": {
              "key": "alice"
            }
          },
          "expect": {
            "status": 200,
            "headers": {
              "Content-Length": "10486784",
              "ETag": "\"crc32c=JKAp5Q==\""
            },
            "body_sha256": "7211b6f571a875312d10a1ade3fd4999d98eabe0c2543b456e3aea74a9fe2bc2"
          }
        },
        {
          "name": "session-gone",
          "request": {
            "method": "GET",
            "path": [
              "-",
              "uploads",
              "{{id}}"
            ],
            "auth": {
              "key": "alice"
            }
          },
          "expect": {
            "error": "upload_not_found"
          }
        },
        {
          "name": "cleanup",
          "request": {
            "method": "DELETE",
            "path": [
              "empty",
              "big.bin"
            ],
            "auth": {
              "key": "alice"
            }
          },
          "expect": {
            "status": 204
          }
        }
      ]
    },
    {
      "name": "upload-complete-with-checksums",
      "description": "Complete may carry the per-part checksums; matching ones are accepted, and a wrong one is rejected naming the part, leaving the session active.",
      "decision": "ADR-0006",
      "fixtures": [
        "alice",
        "empty"
      ],
      "steps": [
        {
          "request": {
            "method": "POST",
            "path": [
              "-",
              "uploads"
            ],
            "auth": {
              "key": "alice"
            },
            "body": {
              "json": {
                "bucket": "empty",
                "key": "sums.bin",
                "part_size": 5242880
              }
            }
          },
          "expect": {
            "status": 201
          },
          "capture": {
            "id": "/id"
          }
        },
        {
          "request": {
            "method": "PUT",
            "path": [
              "-",
              "uploads",
              "{{id}}",
              "parts",
              "1"
            ],
            "auth": {
              "key": "alice"
            },
            "body": {
              "bytes": {
                "seed": 8,
                "length": 5242880
              }
            }
          },
          "expect": {
            "status": 200
          }
        },
        {
          "request": {
            "method": "PUT",
            "path": [
              "-",
              "uploads",
              "{{id}}",
              "parts",
              "2"
            ],
            "auth": {
              "key": "alice"
            },
            "body": {
              "bytes": {
                "seed": 10,
                "length": 1024
              }
            }
          },
          "expect": {
            "status": 200
          }
        },
        {
          "name": "wrong-checksum-for-part-2",
          "request": {
            "method": "POST",
            "path": [
              "-",
              "uploads",
              "{{id}}",
              "complete"
            ],
            "auth": {
              "key": "alice"
            },
            "body": {
              "json": {
                "parts": 2,
                "checksums": [
                  "crc32c=UXMjHQ==",
                  "crc32c=AAAAAA=="
                ]
              }
            }
          },
          "expect": {
            "error": "checksum_mismatch",
            "json": {
              "error": {
                "details": {
                  "part": 2
                }
              }
            }
          }
        },
        {
          "name": "still-active",
          "request": {
            "method": "GET",
            "path": [
              "-",
              "uploads",
              "{{id}}"
            ],
            "auth": {
              "key": "alice"
            }
          },
          "expect": {
            "status": 200,
            "json": {
              "parts": [
                1,
                2
              ]
            }
          }
        },
        {
          "name": "correct-checksums",
          "request": {
            "method": "POST",
            "path": [
              "-",
              "uploads",
              "{{id}}",
              "complete"
            ],
            "auth": {
              "key": "alice"
            },
            "body": {
              "json": {
                "parts": 2,
                "checksums": [
                  "crc32c=UXMjHQ==",
                  "crc32c=16Iysw=="
                ]
              }
            }
          },
          "expect": {
            "status": 201
          }
        },
        {
          "request": {
            "method": "DELETE",
            "path": [
              "empty",
              "sums.bin"
            ],
            "auth": {
              "key": "alice"
            }
          },
          "expect": {
            "status": 204
          }
        }
      ]
    },
