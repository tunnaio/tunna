    {
      "name": "upload-initiate-faults",
      "description": "Stage 4 before stage 6: a bad part size and a bad key are rejected before the bucket is consulted; then an unknown bucket.",
      "decision": "ADR-0004",
      "fixtures": [
        "alice",
        "empty"
      ],
      "steps": [
        {
          "request": {
            "method": "POST",
            "path": [
              "-",
              "uploads"
            ],
            "auth": {
              "key": "alice"
            },
