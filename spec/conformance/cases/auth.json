{
  "spec": "0.1.0-draft",
  "cases": [
    {
      "name": "auth-valid-signature-passes",
      "description": "A correctly signed request to an anonymous route succeeds. The positive case: every failure case below is only meaningful if this one is green.",
      "decision": "ADR-0003",
      "fixtures": ["alice"],
      "steps": [
        {
          "request": { "method": "GET", "path": ["-", "health"], "auth": { "key": "alice" } },
          "expect": { "status": 200, "json": { "status": "ok" } }
        }
      ]
    },
    {
      "name": "auth-valid-signature-with-signed-header-passes",
      "description": "Signing a header the request carries is accepted.",
      "decision": "wire.md 3.2",
      "fixtures": ["alice"],
      "steps": [
        {
          "request": {
            "method": "GET", "path": ["-", "health"],
            "headers": { "X-Tunna-Meta-Probe": "  spaced   value " },
            "auth": { "key": "alice", "signed_headers": ["x-tunna-meta-probe"] }
          },
          "expect": { "status": 200 }
        }
      ]
    },
    {
      "name": "auth-disabled-key-is-unknown",
      "description": "A disabled key authenticates like a nonexistent one; the response does not distinguish them.",
      "decision": "ADR-0003",
      "fixtures": ["revoked"],
      "steps": [
        {
          "request": { "method": "GET", "path": ["-", "health"], "auth": { "key": "revoked" } },
          "expect": { "error": "unknown_key", "headers": { "WWW-Authenticate": "TUNNA1-HMAC-SHA256" } }
        }
      ]
    },
    {
      "name": "auth-clock-skew-ahead",
      "description": "A timestamp an hour ahead of the server is outside the default window.",
      "decision": "wire.md 3.3",
      "fixtures": ["alice"],
      "steps": [
        {
          "request": { "method": "GET", "path": ["-", "health"], "auth": { "key": "alice", "time_offset_seconds": 3600 } },
          "expect": { "error": "clock_skew", "headers": { "WWW-Authenticate": "TUNNA1-HMAC-SHA256" }, "json_present": ["/error/details/server_time", "/error/details/skew_seconds"] }
        }
      ]
    },
    {
      "name": "auth-clock-skew-behind",
      "description": "A timestamp an hour behind the server is outside the default window too.",
      "decision": "wire.md 3.3",
      "fixtures": ["alice"],
      "steps": [
        {
          "request": { "method": "GET", "path": ["-", "health"], "auth": { "key": "alice", "time_offset_seconds": -3600 } },
          "expect": { "error": "clock_skew", "json_present": ["/error/details/server_time"] }
        }
      ]
    },
    {
      "name": "auth-missing-signed-header",
      "description": "The signed-headers list names a header the request does not carry.",
      "decision": "wire.md 3.2",
      "fixtures": ["alice"],
      "steps": [
        {
          "request": { "method": "GET", "path": ["-", "health"], "auth": { "key": "alice", "signed_headers": ["x-tunna-meta-absent"] } },
          "expect": { "error": "missing_signed_header" }
        }
      ]
    },
    {
      "name": "auth-foreign-scheme-is-malformed",
      "description": "An Authorization header with a scheme this server does not speak is a syntax fault, stage 1, not an authentication fault.",
      "decision": "ADR-0004",
      "fixtures": [],
      "steps": [
        {
          "request": { "method": "GET", "path": ["-", "health"], "headers": { "Authorization": "Bearer not-ours" }, "auth": "none" },
          "expect": { "error": "malformed_request" }
        }
      ]
    },
    {
      "name": "auth-signature-over-wrong-path-fails",
      "description": "A signature computed for one path does not authorize another. The runner signs for the path it sends, so this is provoked with a corrupt signature on a non-trivial path.",
      "decision": "ADR-0003",
      "fixtures": ["alice"],
      "steps": [
        {
          "request": { "method": "GET", "path": ["-", "version"], "auth": { "key": "alice", "corrupt_signature": true } },
          "expect": { "error": "bad_signature" }
        }
      ]
    },
    {
      "name": "presign-valid-passes",
      "description": "A presigned URL for an anonymous route is accepted.",
      "decision": "wire.md 3.4",
      "fixtures": ["alice"],
      "steps": [
        {
          "request": { "method": "GET", "path": ["-", "health"], "auth": { "presign": { "key": "alice", "expires_in_seconds": 300 } } },
          "expect": { "status": 200, "json": { "status": "ok" } }
        }
      ]
    },
    {
      "name": "presign-expired",
      "description": "An expiry in the past is rejected with its own code so clients can tell it from a bad signature.",
      "decision": "wire.md 3.4",
      "fixtures": ["alice"],
      "steps": [
        {
          "request": { "method": "GET", "path": ["-", "health"], "auth": { "presign": { "key": "alice", "expires_in_seconds": -60 } } },
          "expect": { "error": "presign_expired", "headers": { "WWW-Authenticate": "TUNNA1-HMAC-SHA256" } }
        }
      ]
    },
    {
      "name": "presign-too-long",
      "description": "An expiry further ahead than the server's maximum lifetime (default 7 days) is rejected.",
      "decision": "wire.md 3.4",
      "fixtures": ["alice"],
      "steps": [
        {
          "request": { "method": "GET", "path": ["-", "health"], "auth": { "presign": { "key": "alice", "expires_in_seconds": 691200 } } },
          "expect": { "error": "presign_too_long" }
        }
      ]
    },
    {
      "name": "presign-disabled-key-is-unknown",
      "description": "Presigned URLs are verified against the key as it is now; a disabled key fails every URL it signed.",
      "decision": "ADR-0003",
      "fixtures": ["revoked"],
      "steps": [
        {
          "request": { "method": "GET", "path": ["-", "health"], "auth": { "presign": { "key": "revoked", "expires_in_seconds": 300 } } },
          "expect": { "error": "unknown_key" }
        }
      ]
    },
    {
      "name": "presign-refused-where-the-body-holds-the-parameters",
      "description": "A presigned URL binds method, path, query and listed headers, not the body. The five routes that take their parameters from a JSON body refuse the presigned form, and nothing was changed by the attempts.",
      "decision": "ADR-0013",
      "fixtures": ["alice", "bob", "empty"],
      "steps": [
        {
          "name": "initiate",
          "request": { "method": "POST", "path": ["-", "uploads"], "auth": { "presign": { "key": "alice", "expires_in_seconds": 300 } }, "body": { "json": { "bucket": "empty", "key": "a.bin", "part_size": 5242880 } } },
          "expect": { "error": "presign_not_allowed", "headers": { "WWW-Authenticate": "TUNNA1-HMAC-SHA256" } }
        },
        {
          "name": "bucket-create",
          "request": { "method": "PUT", "path": ["-", "buckets", "made-by-url"], "auth": { "presign": { "key": "alice", "expires_in_seconds": 300 } }, "body": { "json": { "public": true } } },
          "expect": { "error": "presign_not_allowed" }
        },
        {
          "name": "bucket-patch",
          "request": { "method": "PATCH", "path": ["-", "buckets", "empty"], "auth": { "presign": { "key": "alice", "expires_in_seconds": 300 } }, "body": { "json": { "public": true } } },
          "expect": { "error": "presign_not_allowed" }
        },
        {
          "name": "key-create",
          "request": { "method": "POST", "path": ["-", "keys"], "auth": { "presign": { "key": "alice", "expires_in_seconds": 300 } }, "body": { "json": { "name": "made-by-url", "admin": true } } },
          "expect": { "error": "presign_not_allowed" }
        },
        {
          "name": "key-patch",
          "request": { "method": "PATCH", "path": ["-", "keys", "tk_bob"], "auth": { "presign": { "key": "alice", "expires_in_seconds": 300 } }, "body": { "json": { "disabled": true } } },
          "expect": { "error": "presign_not_allowed" }
        },
        {
          "name": "no-bucket-was-made",
          "request": { "method": "GET", "path": ["-", "buckets", "made-by-url"], "auth": { "key": "alice" } },
          "expect": { "error": "bucket_not_found" }
        },
        {
          "name": "bucket-unchanged",
          "request": { "method": "GET", "path": ["-", "buckets", "empty"], "auth": { "key": "alice" } },
          "expect": { "status": 200, "json": { "public": false } }
        },
        {
          "name": "bob-still-enabled",
          "request": { "method": "GET", "path": ["-", "keys", "self"], "auth": { "key": "bob" } },
          "expect": { "status": 200, "json": { "id": "tk_bob", "disabled": false } }
        }
      ]
    },
    {
      "name": "presign-refusal-is-stage-2",
      "description": "The refusal is about the credentials presented, so it comes before stage 3: a scoped key that may not manage keys or buckets at all is told presign_not_allowed, not forbidden.",
      "decision": "ADR-0013, ADR-0004",
      "fixtures": ["reader"],
      "steps": [
        {
          "request": { "method": "POST", "path": ["-", "keys"], "auth": { "presign": { "key": "reader", "expires_in_seconds": 300 } }, "body": { "json": { "name": "x", "admin": true } } },
          "expect": { "error": "presign_not_allowed" }
        },
        {
          "request": { "method": "PUT", "path": ["-", "buckets", "made-by-url"], "auth": { "presign": { "key": "reader", "expires_in_seconds": 300 } } },
          "expect": { "error": "presign_not_allowed" }
        },
        {
          "name": "header-form-reaches-stage-3",
          "request": { "method": "POST", "path": ["-", "keys"], "auth": { "key": "reader" }, "body": { "json": { "name": "x", "admin": true } } },
          "expect": { "error": "forbidden" }
        }
      ]
    },
    {
      "name": "presign-a-whole-upload-after-a-header-form-initiate",
      "description": "What a browser does: its backend initiates in header form, then every other step of the session is a presigned URL, complete included although it has a body.",
      "decision": "ADR-0013",
      "fixtures": ["alice", "empty"],
      "steps": [
        {
          "name": "initiate",
          "request": { "method": "POST", "path": ["-", "uploads"], "auth": { "key": "alice" }, "body": { "json": { "bucket": "empty", "key": "by-url.bin", "part_size": 5242880 } } },
          "expect": { "status": 201 },
          "capture": { "id": "/id" }
        },
        {
          "name": "part",
          "request": { "method": "PUT", "path": ["-", "uploads", "{{id}}", "parts", "1"], "auth": { "presign": { "key": "alice", "expires_in_seconds": 300 } }, "body": { "bytes": { "seed": 10, "length": 1024 } } },
          "expect": { "status": 200, "json": { "part": 1, "size": 1024, "checksum": "crc32c=16Iysw==" } }
        },
        {
          "name": "query",
          "request": { "method": "GET", "path": ["-", "uploads", "{{id}}"], "auth": { "presign": { "key": "alice", "expires_in_seconds": 300 } } },
          "expect": { "status": 200, "json": { "id": "{{id}}" } }
        },
        {
          "name": "complete",
          "request": { "method": "POST", "path": ["-", "uploads", "{{id}}", "complete"], "auth": { "presign": { "key": "alice", "expires_in_seconds": 300 } }, "body": { "json": { "parts": 1 } } },
          "expect": { "status": 201, "json": { "bucket": "empty", "key": "by-url.bin", "size": 1024, "checksum": "crc32c=16Iysw==" } }
        },
        {
          "name": "read-back",
          "request": { "method": "GET", "path": ["empty", "by-url.bin"], "auth": { "presign": { "key": "alice", "expires_in_seconds": 300 } } },
          "expect": { "status": 200, "body_bytes": { "seed": 10, "length": 1024 } }
        }
      ]
    },
    {
      "name": "presign-abort-and-the-bodyless-control-routes",
      "description": "Routes fully described by method and path stay presignable: abort a session, read and delete a bucket, read and delete a key.",
      "decision": "ADR-0013",
      "fixtures": ["alice", "bob", "empty"],
      "steps": [
        {
          "name": "initiate",
          "request": { "method": "POST", "path": ["-", "uploads"], "auth": { "key": "alice" }, "body": { "json": { "bucket": "empty", "key": "gone.bin", "part_size": 5242880 } } },
          "expect": { "status": 201 },
          "capture": { "id": "/id" }
        },
        {
          "name": "abort",
          "request": { "method": "DELETE", "path": ["-", "uploads", "{{id}}"], "auth": { "presign": { "key": "alice", "expires_in_seconds": 300 } } },
          "expect": { "status": 204 }
        },
        {
          "name": "bucket-list",
          "request": { "method": "GET", "path": ["-", "buckets"], "auth": { "presign": { "key": "alice", "expires_in_seconds": 300 } } },
          "expect": { "status": 200 }
        },
        {
          "name": "bucket-get",
          "request": { "method": "GET", "path": ["-", "buckets", "empty"], "auth": { "presign": { "key": "alice", "expires_in_seconds": 300 } } },
          "expect": { "status": 200, "json": { "name": "empty" } }
        },
        {
          "name": "bucket-delete",
          "request": { "method": "DELETE", "path": ["-", "buckets", "empty"], "auth": { "presign": { "key": "alice", "expires_in_seconds": 300 } } },
          "expect": { "status": 204 }
        },
        {
          "name": "key-get",
          "request": { "method": "GET", "path": ["-", "keys", "tk_bob"], "auth": { "presign": { "key": "alice", "expires_in_seconds": 300 } } },
          "expect": { "status": 200, "json": { "id": "tk_bob" } }
        },
        {
          "name": "key-delete",
          "request": { "method": "DELETE", "path": ["-", "keys", "tk_bob"], "auth": { "presign": { "key": "alice", "expires_in_seconds": 300 } } },
          "expect": { "status": 204 }
        }
      ]
    }
  ]
}
