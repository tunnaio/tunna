{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tunnaio/tunna/spec/vectors/cors.schema.json",
  "title": "tunna CORS origin-matching vectors",
  "type": "object",
  "required": ["spec", "cases"],
  "additionalProperties": false,
  "properties": {
    "spec": { "type": "string" },
    "description": { "type": "string" },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "allow"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "allow": {
            "type": "array",
            "description": "The configured list, as an operator would type it, before normalisation.",
            "items": { "type": "string" }
          },
          "origin": { "type": "string", "description": "The request's Origin header value, byte for byte." },
          "match": { "type": "boolean" },
          "value": { "type": "string", "description": "Access-Control-Allow-Origin to answer with when match is true: the origin itself, or *." },
          "invalid": { "type": "boolean", "const": true, "description": "The list must be refused at startup. Such a case has no origin, match or value." },
          "reason": { "type": "string" }
        },
        "oneOf": [
          { "required": ["origin", "match"], "not": { "required": ["invalid"] } },
          { "required": ["invalid"], "not": { "anyOf": [ { "required": ["origin"] }, { "required": ["match"] }, { "required": ["value"] } ] } }
        ]
      }
    }
  }
}
