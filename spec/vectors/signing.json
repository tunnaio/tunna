{
  "spec": "0.1.0-draft",
  "cases": [
    {
      "name": "header-get-root",
      "note": "Smallest possible request: GET / with nothing signed.",
      "mode": "header",
      "key": {
        "id": "tk_alice",
        "secret": "test-secret-alice-not-real"
      },
      "request": {
        "method": "GET",
        "path": []
      },
      "time": 1788912000,
      "expected": {
        "canonical": "TUNNA1\nGET\n/\n\n\n\n1788912000",
        "signature": "1e2c9dcf5d1c84f394c0fc362eb7c905210a1b1d299945b11a3eff631b2f3e2a",
        "authorization": "TUNNA1-HMAC-SHA256 key=tk_alice, headers=, sig=1e2c9dcf5d1c84f394c0fc362eb7c905210a1b1d299945b11a3eff631b2f3e2a"
      }
    },
    {
