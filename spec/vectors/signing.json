    {
      "name": "presign-get-object",
      "note": "Presigned download, no signed headers. time is the absolute expiry. x-tunna-sig is appended after the canonical query.",
      "mode": "presign",
      "key": {
        "id": "tk_alice",
        "secret": "test-secret-alice-not-real"
      },
      "request": {
        "method": "GET",
        "path": [
          "photos",
          "hello.txt"
        ]
      },
      "time": 1788915600,
      "expected": {
        "canonical": "TUNNA1\nGET\n/photos/hello.txt\nx-tunna-expires=1788915600&x-tunna-headers=&x-tunna-key=tk_alice\n\n\n1788915600",
        "signature": "e3c93f42efea052e6f81bab81d6666381c6dfe70c21b72ce5e0b81dc901d8013",
        "query": "x-tunna-expires=1788915600&x-tunna-headers=&x-tunna-key=tk_alice&x-tunna-sig=e3c93f42efea052e6f81bab81d6666381c6dfe70c21b72ce5e0b81dc901d8013"
      }
    },
