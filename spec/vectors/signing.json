      }
    },
    {
      "name": "header-get-key-with-slash-space-unicode",
      "note": "The key is one segment as far as the signer is concerned; its slash, space and non-ASCII are data.",
      "mode": "header",
      "key": {
        "id": "tk_alice",
        "secret": "test-secret-alice-not-real"
      },
      "request": {
        "method": "GET",
        "path": [
          "photos",
          "år 2026/bild #1.jpg"
        ]
      },
      "time": 1788912000,
      "expected": {
        "canonical": "TUNNA1\nGET\n/photos/%C3%A5r%202026%2Fbild%20%231.jpg\n\n\n\n1788912000",
        "signature": "6ef81d44eefca99dff58f0fce0a63927c63d1c515b2e30c987a52e4b8a15a733",
        "authorization": "TUNNA1-HMAC-SHA256 key=tk_alice, headers=, sig=6ef81d44eefca99dff58f0fce0a63927c63d1c515b2e30c987a52e4b8a15a733"
      }
    },
    {
      "name": "header-list-sorted-query",
      "note": "Query parameters given out of order; canonical form sorts by encoded name.",
      "mode": "header",
      "key": {
        "id": "tk_alice",
        "secret": "test-secret-alice-not-real"
      },
      "request": {
        "method": "GET",
        "path": [
          "photos"
        ],
        "query": [
          [
            "prefix",
            "2026/"
          ],
          [
            "list",
            ""
          ],
          [
            "limit",
            "10"
          ],
          [
            "delimiter",
            "/"
          ]
        ]
      },
      "time": 1788912000,
      "expected": {
        "canonical": "TUNNA1\nGET\n/photos\ndelimiter=%2F&limit=10&list=&prefix=2026%2F\n\n\n1788912000",
        "signature": "09809f535d0e7ac34b5b84cbb57d24a9c8f8dfa0af79613f886655c495baa1e9",
        "authorization": "TUNNA1-HMAC-SHA256 key=tk_alice, headers=, sig=09809f535d0e7ac34b5b84cbb57d24a9c8f8dfa0af79613f886655c495baa1e9"
      }
    },
    {
      "name": "header-repeated-and-empty-params",
      "note": "Repeated names sort by value; empty values keep their =.",
      "mode": "header",
      "key": {
        "id": "tk_alice",
        "secret": "test-secret-alice-not-real"
      },
      "request": {
        "method": "GET",
        "path": [
          "photos"
        ],
        "query": [
          [
            "k",
            "b"
          ],
          [
            "k",
            ""
          ],
          [
            "k",
            "a"
          ],
          [
            "list",
            ""
          ]
        ]
      },
      "time": 1788912000,
      "expected": {
        "canonical": "TUNNA1\nGET\n/photos\nk=&k=a&k=b&list=\n\n\n1788912000",
        "signature": "bb693bfbe91093cc19c97e86c4f24f6e3d46c0b985932ef5550b08ab41a2ce3e",
        "authorization": "TUNNA1-HMAC-SHA256 key=tk_alice, headers=, sig=bb693bfbe91093cc19c97e86c4f24f6e3d46c0b985932ef5550b08ab41a2ce3e"
      }
    },
    {
      "name": "header-put-with-signed-checksum",
      "note": "Body integrity via a signed checksum header. The checksum header name is a placeholder until the checksum ADR (wire.md section 8). The body itself is not an input.",
      "mode": "header",
      "key": {
        "id": "tk_alice",
        "secret": "test-secret-alice-not-real"
      },
      "request": {
        "method": "PUT",
        "path": [
          "photos",
          "new.bin"
        ],
        "headers": {
          "Content-Type": "application/octet-stream",
          "X-Tunna-Checksum": "crc32c=AAAAAA=="
        },
        "signed_headers": [
          "X-Tunna-Checksum",
          "Content-Type"
        ]
      },
      "time": 1788912000,
      "expected": {
        "canonical": "TUNNA1\nPUT\n/photos/new.bin\n\ncontent-type;x-tunna-checksum\ncontent-type:application/octet-stream\nx-tunna-checksum:crc32c=AAAAAA==\n1788912000",
        "signature": "f63ed1cd5bc51071e59e69803bcd865647fe9b78d75f14929a784f9249c96c3a",
        "authorization": "TUNNA1-HMAC-SHA256 key=tk_alice, headers=content-type;x-tunna-checksum, sig=f63ed1cd5bc51071e59e69803bcd865647fe9b78d75f14929a784f9249c96c3a"
      }
    },
    {
      "name": "header-whitespace-and-case-normalized",
      "note": "Header names are lowercased and sorted; values are trimmed and internal whitespace runs collapse to one space. Unsigned headers are ignored.",
      "mode": "header",
      "key": {
        "id": "tk_bob",
        "secret": "test-secret-bob-not-real"
      },
      "request": {
        "method": "PUT",
        "path": [
          "photos",
          "meta.txt"
        ],
        "headers": {
          "X-Tunna-Meta-Title": "   Summer   holiday\t2026  ",
          "CONTENT-TYPE": "text/plain; charset=utf-8",
          "User-Agent": "not-signed/1.0"
        },
        "signed_headers": [
          "x-tunna-meta-title",
          "Content-Type"
        ]
      },
      "time": 1788912000,
      "expected": {
        "canonical": "TUNNA1\nPUT\n/photos/meta.txt\n\ncontent-type;x-tunna-meta-title\ncontent-type:text/plain; charset=utf-8\nx-tunna-meta-title:Summer holiday 2026\n1788912000",
        "signature": "b07e9ee5a0d76a98efd9f13c625ba1cc9f79f3179f0a2740ae8dd21456d8265d",
        "authorization": "TUNNA1-HMAC-SHA256 key=tk_bob, headers=content-type;x-tunna-meta-title, sig=b07e9ee5a0d76a98efd9f13c625ba1cc9f79f3179f0a2740ae8dd21456d8265d"
      }
    },
    {
      "name": "header-post-json-body-not-signed",
      "note": "Initiate upload. The JSON body does not enter the canonical request; two requests with different bodies and the same headers sign identically.",
      "mode": "header",
      "key": {
        "id": "tk_alice",
        "secret": "test-secret-alice-not-real"
      },
      "request": {
        "method": "POST",
        "path": [
          "-",
          "uploads"
        ],
        "headers": {
          "Content-Type": "application/json"
        },
        "signed_headers": [
          "content-type"
        ]
      },
      "time": 1788912000,
      "expected": {
        "canonical": "TUNNA1\nPOST\n/-/uploads\n\ncontent-type\ncontent-type:application/json\n1788912000",
        "signature": "f2c0b4faeca810db7ddb6dafb1ff79e7c0e7a79b8ad5cdb7848ce8cedc7ee926",
        "authorization": "TUNNA1-HMAC-SHA256 key=tk_alice, headers=content-type, sig=f2c0b4faeca810db7ddb6dafb1ff79e7c0e7a79b8ad5cdb7848ce8cedc7ee926"
      }
    },
