{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tunnaio/tunna/spec/vectors/crc32c.schema.json",
  "title": "tunna CRC32C vectors",
  "description": "Oracle for the checksum scheme (ADR-0006): the CRC32C of given bytes, its wire encoding, and the combination of per-part CRCs into the whole-object CRC. 'single' cases check the hash and the encoding; 'combine' cases check that combine(crc_a, crc_b, len_b) over the listed parts equals the CRC of their concatenation. Inputs use the same forms as conformance bodies: text, hex, or generated bytes.",
  "type": "object",
  "required": ["spec", "encoding", "single", "combine"],
  "additionalProperties": false,
  "properties": {
    "spec": { "type": "string" },
    "encoding": { "type": "string", "description": "The algorithm and wire form, restated so the file stands alone." },
    "single": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "input", "crc32c_hex", "wire"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "input": { "$ref": "#/$defs/input" },
          "crc32c_hex": { "type": "string", "pattern": "^[0-9a-f]{8}$" },
          "wire": { "type": "string", "pattern": "^crc32c=[A-Za-z0-9+/]{6}==$" }
        }
      }
    },
    "combine": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "parts", "part_crc32c_hex", "part_lengths", "whole_crc32c_hex", "wire"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "parts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/input" } },
          "part_crc32c_hex": { "type": "array", "items": { "type": "string", "pattern": "^[0-9a-f]{8}$" } },
          "part_lengths": { "type": "array", "items": { "type": "integer", "minimum": 0 } },
          "whole_crc32c_hex": { "type": "string", "pattern": "^[0-9a-f]{8}$" },
          "wire": { "type": "string" }
        }
      }
    }
  },
  "$defs": {
    "input": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "additionalProperties": false,
      "properties": {
        "text": { "type": "string" },
        "hex": { "type": "string", "pattern": "^([0-9a-f]{2})*$" },
        "bytes": { "type": "object", "required": ["seed", "length"], "additionalProperties": false, "properties": {
          "seed": { "type": "integer" },
          "length": { "type": "integer", "minimum": 0 }
        } }
      }
    }
  }
}
