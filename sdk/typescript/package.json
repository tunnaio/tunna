{
  "name": "tunna",
  "version": "0.1.0-alpha.8",
  "description": "Client for the tunna object store: signer, presigned URLs, concurrent uploads. Browser and Node, no dependencies.",
  "keywords": [
    "object-storage",
    "s3",
    "tunna",
    "upload",
    "presigned-url"
  ],
  "license": "MIT",
  "homepage": "https://github.com/tunnaio/tunna/tree/main/sdk/typescript#readme",
  "bugs": {
    "url": "https://github.com/tunnaio/tunna/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tunnaio/tunna.git",
    "directory": "sdk/typescript"
  },
  "type": "module",
  "engines": {
    "node": ">=20.3.0"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./sign": {
      "import": {
        "types": "./dist/sign.d.mts",
        "default": "./dist/sign.mjs"
      },
      "require": {
        "types": "./dist/sign.d.cts",
        "default": "./dist/sign.cjs"
      }
    },
    "./encode": {
      "import": {
        "types": "./dist/encode.d.mts",
        "default": "./dist/encode.mjs"
      },
      "require": {
        "types": "./dist/encode.d.cts",
        "default": "./dist/encode.cjs"
      }
    },
    "./crc32c": {
      "import": {
        "types": "./dist/crc32c.d.mts",
        "default": "./dist/crc32c.mjs"
      },
      "require": {
        "types": "./dist/crc32c.d.cts",
        "default": "./dist/crc32c.cjs"
      }
    },
    "./xhr": {
      "import": {
        "types": "./dist/xhr.d.mts",
        "default": "./dist/xhr.mjs"
      },
      "require": {
        "types": "./dist/xhr.d.cts",
        "default": "./dist/xhr.cjs"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "check": "tsc --noEmit && tsc -p ../../scripts",
    "test": "bun test",
    "gen": "bun run scripts/gen-errors.ts",
    "smoke": "bun run build && node test/node-smoke.mjs && node test/node-smoke.cjs",
    "prepublishOnly": "bun run check && bun test && bun run build",
    "bump": "bun pm version prerelease --no-git-tag-version"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "tsdown": "0.23.0",
    "typescript": "7.0.2"
  }
}
